<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NinaTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MyUniverseUplink</RootNamespace>
    <AssemblyName>MyUniverseUplink</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="$(NinaPluginPackageVersion)" />
    <ProjectReference Include="..\Uplink.Core\Uplink.Core.csproj" />
  </ItemGroup>
</Project>
