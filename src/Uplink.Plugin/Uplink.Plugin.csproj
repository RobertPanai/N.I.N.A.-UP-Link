<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NinaTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MyUniverseUplink</RootNamespace>
    <AssemblyName>MyUniverseUplink</AssemblyName>
    <!-- Il plugin e' Windows-only per definizione (TFM net8.0-windows7.0, DPAPI e WPF): CA1416 non aggiunge informazione. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="$(NinaPluginPackageVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\Uplink.Core\Uplink.Core.csproj" />
  </ItemGroup>
</Project>
