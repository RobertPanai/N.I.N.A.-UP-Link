<UserControl x:Class="MyUniverseUplink.Options.UplinkOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ButtonForegroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="NotReadyText"
                   Visibility="Collapsed"
                   Margin="16"
                   TextWrapping="Wrap"
                   Text="The plugin is not running. Restart N.I.N.A. and open this page again." />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="My Universe Uplink" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Sends metadata and thumbnails of saved frames to your site. Settings apply to the active profile." />
                <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Connection" />
                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,0,6" />
                <TextBlock Text="Server URL (https; http only for localhost)" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                <TextBlock Text="Device ID" />
                <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                <TextBlock Text="Token" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="TokenBox" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Save token" Click="OnSaveToken" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding TokenState}" />

                <TextBlock Text="Extra header name (optional, e.g. x-vercel-protection-bypass)" />
                <TextBox Text="{Binding ExtraHeaderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="HeaderValueBox" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Save header value" Click="OnSaveHeaderValue" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding HeaderState}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Test connection" Click="OnTestConnection" />
                    <Button Content="Save settings" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="What to send" />
                <WrapPanel>
                    <CheckBox Content="LIGHT" IsChecked="{Binding SendLight}" Margin="0,0,16,6" />
                    <CheckBox Content="FLAT" IsChecked="{Binding SendFlat}" Margin="0,0,16,6" />
                    <CheckBox Content="DARK" IsChecked="{Binding SendDark}" Margin="0,0,16,6" />
                    <CheckBox Content="BIAS" IsChecked="{Binding SendBias}" Margin="0,0,16,6" />
                </WrapPanel>
                <CheckBox Content="Only frames with a target" IsChecked="{Binding RequireTarget}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Default: LIGHT frames with a target. If no type is checked, LIGHT is used." />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Thumbnails" />
                <ComboBox ItemsSource="{Binding ThumbnailModes}"
                          SelectedItem="{Binding SelectedThumbnailMode}"
                          Width="200"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,8" />
                <TextBlock Text="Long edge in px (100-1600)" />
                <TextBox Text="{Binding ThumbnailEdge, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left"
                         Margin="0,2,0,8" />
                <TextBlock Text="JPEG quality (30-95)" />
                <TextBox Text="{Binding ThumbnailQuality, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         HorizontalAlignment="Left"
                         Margin="0,2,0,4" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Live streams" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Live streams shown on your site (for example an all-sky camera). The list replaces what the site shows for this device. Turn the switch off to hide the section. Works with the frame uplink on or off." />
                <CheckBox Content="Publish live streams on the site" IsChecked="{Binding Streams.Enabled}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Streams.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#33808A9E" Padding="0,6,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Title (max 80)" />
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Description (optional, max 400)" />
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="URL (https, max 2000)" />
                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,4,16,8" />
                                        <Button Content="Move up" Command="{Binding UpCommand}" />
                                        <Button Content="Move down" Command="{Binding DownCommand}" />
                                        <Button Content="Remove" Command="{Binding RemoveCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Issue}" TextWrapping="Wrap" Foreground="#FF6B6B" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Streams.ListIssue}" TextWrapping="Wrap" Foreground="#FF6B6B" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Add stream" Command="{Binding Streams.AddCommand}" />
                    <Button Content="Sync now" Command="{Binding Streams.SyncNowCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding Streams.StatusText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Streams.Message}" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Status" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontFamily="Consolas" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Send last image" Command="{Binding SendLastCommand}" />
                    <Button Content="Flush now" Command="{Binding FlushCommand}" />
                    <Button Content="Retry dead" Command="{Binding RetryDeadCommand}" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                </WrapPanel>
                <CheckBox Content="HTML report (local debug file)" IsChecked="{Binding HtmlReport}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="Activity" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Every action of the plugin, newest at the bottom. The same lines are written to logs\activity.log." />
                <WrapPanel Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding Activity.Filters}"
                              SelectedItem="{Binding Activity.SelectedFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="150"
                              Margin="0,0,16,8" />
                    <CheckBox Content="Follow" IsChecked="{Binding Activity.Follow, Mode=TwoWay}" Margin="0,4,16,8" />
                    <Button Content="Copy" Command="{Binding Activity.CopyCommand}" />
                    <Button Content="Clear" Command="{Binding Activity.ClearCommand}" />
                </WrapPanel>
                <ListBox x:Name="ActivityList"
                         Height="280"
                         ItemsSource="{Binding Activity.Lines}"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="{DynamicResource BackgroundBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Focusable="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Padding="0,1">
                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="#8A93A6" />
                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="#8A93A6" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
